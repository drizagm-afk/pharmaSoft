              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if(!Number.isInteger(Number(pm.collectionVariables.get(\"categoriaId\")))||Number(pm.collectionVariables.get(\"categoriaId\"))<=0) throw Error(\"Completar categoriaId con un ID positivo\");"
                ]
