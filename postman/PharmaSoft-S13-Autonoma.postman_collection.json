    {
      "name": "00 — Login admin",
      "description": "Completar adminPassword localmente; valor inicial demo Admin2026* si no se cambió. Renovar tras reiniciar Java. No capturar/exportar token.",
      "item": [
        {
          "name": "Login y guardar token",
          "request": {
            "method": "POST",
            "url": "{{backendUrl}}/api/v1/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\"username\":\"{{adminUsername}}\",\"password\":\"{{adminPassword}}\"}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"tokenAdmin\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "if(pm.response.code===200){const b=pm.response.json();pm.test(\"Token\",()=>pm.expect(b.token).to.be.a(\"string\").and.not.empty);if(b.token)pm.collectionVariables.set(\"tokenAdmin\",b.token);}"
                ]
              }
            }
          ]
        }
      ]
    },
