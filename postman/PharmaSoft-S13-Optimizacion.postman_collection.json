  "item": [
    {
      "name": "00 — Diagnóstico y login",
      "description": "Primero comprobar salud directa y proxy. Los logins guardan tokens en variables de colección, sin imprimirlos. Contraseñas iniciales demo; usar las vigentes si se cambiaron.",
      "item": [
        {
          "name": "Salud backend directa",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backendUrl}}/api/v1/health",
            "description": "",
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Request ID de ocho caracteres\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[a-f0-9]{8}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "Salud por Nginx — detectar 502",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{webUrl}}/api/v1/health",
            "description": "",
            "auth": {
              "type": "noauth"
