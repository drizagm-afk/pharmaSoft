                ]
              }
            }
          ]
        },
        {
          "name": "Login admin — guardar token",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{backendUrl}}/api/v1/auth/login",
            "description": "",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{adminUsername}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.unset(\"tokenAdmin\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "if (pm.response.code === 200) {",
                  " const data=pm.response.json();",
                  " pm.test(\"Token recibido\",()=>pm.expect(data.token).to.be.a(\"string\").and.not.empty);",
                  " if(data.token) pm.collectionVariables.set(\"tokenAdmin\",data.token);",
                  "}",
                  "pm.test(\"Request ID de ocho caracteres\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[a-f0-9]{8}$/));"
                ]
              }
            }
          ]
        },
