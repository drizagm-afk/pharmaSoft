                  "pm.test(\"La lista incluye la categoría creada\",()=>{ const id=Number(pm.collectionVariables.get(\"categoriaId\")); pm.expect(id).to.be.above(0); pm.expect(pm.response.json().some(c=>c.id===id)).to.equal(true); });",
                  "pm.test(\"Request ID de ocho caracteres\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[a-f0-9]{8}$/));"
                ]
              }
            }
          ]
        }
      ]
