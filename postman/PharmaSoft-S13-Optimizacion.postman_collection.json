    {
      "name": "03 — P09 — Venta e invalidación de stock",
      "description": "Preferiblemente registrar la venta en la SPA para capturar interacción. Alternativamente esta carpeta registra UNA venta real. Primero completar clienteId activo, productoId activo con stock y cantidad. No ejecutar el POST dos veces. El listado anterior llena caché paginada; el posterior comprueba el mismo listado. Si se usa SPA, omitir POST y guardar cantidad/stockAntes manualmente.",
      "item": [
        {
          "name": "Consultar clientes para elegir ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backendUrl}}/api/v1/clientes?pagina=0&tamanio=100",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Request ID de ocho caracteres\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[a-f0-9]{8}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "P09.1 — Listar productos y guardar stock anterior",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backendUrl}}/api/v1/productos?pagina=0&tamanio=100&ordenarPor=nombre&direccion=asc",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const p=pm.response.json().contenido.find(p=>p.id===Number(pm.collectionVariables.get(\"productoId\")));",
                  "pm.test(\"Producto seleccionado activo y stock suficiente\",()=>{pm.expect(p,\"Completar productoId y comprobar que figura en esta página\").to.exist;pm.expect(p.estado).to.equal(true);pm.expect(Number(pm.collectionVariables.get(\"cantidad\"))).to.be.above(0);pm.expect(p.stock).to.be.at.least(Number(pm.collectionVariables.get(\"cantidad\")));});",
                  "if(p) pm.collectionVariables.set(\"stockAntes\",p.stock);",
                  "pm.test(\"Request ID de ocho caracteres\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[a-f0-9]{8}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "P09.2 — Registrar UNA venta (escritura real)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{backendUrl}}/api/v1/ventas",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"clienteId\":{{clienteId}},\"detalles\":[{\"productoId\":{{productoId}},\"cantidad\":{{cantidad}}}]}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "for(const key of [\"clienteId\",\"productoId\",\"cantidad\"]) {if(!Number.isInteger(Number(pm.collectionVariables.get(key)))||Number(pm.collectionVariables.get(key))<=0) throw new Error(\"Completar variable positiva: \"+key);}",
                  "if(pm.collectionVariables.get(\"stockAntes\")===\"\") throw new Error(\"Ejecutar antes P09.1\");",
                  "if(pm.collectionVariables.get(\"ventaId\")) {pm.execution.skipRequest();throw new Error(\"Ya existe ventaId; revisar la venta antes de registrar otra\");}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "if(pm.response.code===201) pm.collectionVariables.set(\"ventaId\",pm.response.json().id);",
                  "pm.test(\"Request ID de ocho caracteres\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[a-f0-9]{8}$/));"
                ]
              }
            }
          ]
        },
        {
          "name": "P09.3 — Listado refleja descuento de stock",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backendUrl}}/api/v1/productos?pagina=0&tamanio=100&ordenarPor=nombre&direccion=asc",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Stock actualizado en la lista cacheada\",()=>{const p=pm.response.json().contenido.find(p=>p.id===Number(pm.collectionVariables.get(\"productoId\")));pm.expect(p).to.exist;pm.expect(p.stock).to.equal(Number(pm.collectionVariables.get(\"stockAntes\"))-Number(pm.collectionVariables.get(\"cantidad\")));});",
                  "pm.test(\"Request ID de ocho caracteres\", () => pm.expect(pm.response.headers.get(\"X-Request-Id\")).to.match(/^[a-f0-9]{8}$/));"
                ]
              }
            }
          ]
        }
      ]
    },
