            }
          ]
        },
        {
          "name": "P08.2 — Crear categoría de prueba",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{backendUrl}}/api/v1/categorias",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"nombre\":\"{{categoriaNombre}}\",\"descripcion\":\"Validación de invalidación S13\",\"estado\":true}",
