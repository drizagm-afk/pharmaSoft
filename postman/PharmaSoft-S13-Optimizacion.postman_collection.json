        {
          "name": "P10.3 — Admin identifica Redis DOWN y Oracle UP",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{backendUrl}}/actuator/health",
            "description": "",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 503\", () => pm.response.to.have.status(503));",
                  "pm.test(\"Redis DOWN, base UP\",()=>{const b=pm.response.json();pm.expect(b.components.redis.status).to.equal(\"DOWN\");pm.expect(b.components.db.status).to.equal(\"UP\");});"
                ]
              }
            }
