      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/productos",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAlterado}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const token = pm.collectionVariables.get(\"tokenVendedor\");",
              "if (!token) throw new Error(\"Primero iniciar sesión como vendedor\");",
              "const p = token.split(\".\");",
              "p[2] = (p[2][0] === \"A\" ? \"B\" : \"A\") + p[2].slice(1);",
              "pm.collectionVariables.set(\"tokenAlterado\", p.join(\".\"));"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
